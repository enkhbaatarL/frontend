{
  "name": "mi-platform-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev-vdi": "vite --host --mode vdi",
    "mock": "npm-run-all --parallel mock-server mock-api mock-dev",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "mock-dev": "vite --host --mode mock",
    "mock-server": "prism mock mock/mock-api.json",
    "mock-api": "http-server ./mock -p 9000",
    "prepare": "husky install",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "prettier --write --ignore-unknown",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.7",
    "@mui/material": "^6.4.11",
    "@mui/system": "^7.1.0",
    "@mui/x-data-grid": "^7.27.3",
    "@mui/x-date-pickers": "^7.29.3",
    "@tanstack/react-form": "^1.3.3",
    "@tanstack/react-query": "^5.67.2",
    "axios": "^1.8.2",
    "chart.js": "^4.4.8",
    "chartjs-chart-financial": "^0.2.1",
    "chartjs-chart-treemap": "^3.1.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "dompurify": "^3.2.5",
    "es-hangul": "^2.3.3",
    "html-react-parser": "^5.2.5",
    "i18next": "^24.2.2",
    "i18next-http-backend": "^3.0.2",
    "lodash-es": "^4.17.21",
    "notistack": "^3.0.2",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^6.0.0",
    "react-fast-marquee": "^1.6.5",
    "react-i18next": "^15.4.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.3.0",
    "react-virtuoso": "^4.12.5",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.6",
    "@eslint/js": "^9.21.0",
    "@stoplight/prism-cli": "^5.12.0",
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/addon-onboarding": "^8.6.12",
    "@storybook/addon-themes": "^8.6.12",
    "@storybook/blocks": "^8.6.12",
    "@storybook/experimental-addon-test": "^8.6.12",
    "@storybook/react": "^8.6.12",
    "@storybook/react-vite": "^8.6.12",
    "@storybook/test": "^8.6.12",
    "@stylistic/eslint-plugin-js": "^4.2.0",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^3.1.1",
    "@vitest/coverage-v8": "^3.1.1",
    "eslint": "^9.21.0",
    "eslint-import-resolver-typescript": "^3.8.6",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-storybook": "^0.12.0",
    "globals": "^15.15.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.52.0",
    "prettier": "^3.5.3",
    "sass-embedded": "^1.85.1",
    "storybook": "^8.6.12",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vitest": "^3.1.1"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
